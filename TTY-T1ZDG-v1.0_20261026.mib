	    SYNTAX     NvmeDiskInfoEntry
	    MAX-ACCESS read-only
	    STATUS     current
	    DESCRIPTION
	           "The NvmeDisk information associated with the disk of this entry."
	    INDEX   { 
				  nvmeDiskInfoIndex
	            }
	    ::= { nvmeDiskInfoTable 1 }   
	
	NvmeDiskInfoEntry ::= SEQUENCE {
	  	nvmeDiskInfoIndex  			Integer32,
	    nvmeDiskInfoLocation		DisplayString,
		nvmeDiskInfoProtocol		DisplayString, 
		nvmeDiskInfoFWVersion		DisplayString,
	    nvmeDiskInfoModel			DisplayString,
		nvmeDiskInfoMfr				DisplayString,
	    nvmeDiskInfoSerialNo		DisplayString,
		nvmeDiskInfoLinkSpeed		DisplayString,
		nvmeDiskInfoCapacity		DisplayString,
		nvmeDiskInfoTemp			DisplayString,
		nvmeDiskInfoPdlu  			Integer32,
		nvmeDiskInfoStatus			Integer32
	   }
	
	nvmeDiskInfoIndex  OBJECT-TYPE
		SYNTAX 			Integer32 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The index value which uniquely identifies the interface to which this entry is applicable.
		"
		::= {nvmeDiskInfoEntry 1}
	     		  
	nvmeDiskInfoLocation  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The location associated with the NvmeDisk of this entry.
		"
		::= {nvmeDiskInfoEntry 2}
		
	nvmeDiskInfoProtocol  OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The protocol associated with the NvmeDisk of this entry .
		"
		::= {nvmeDiskInfoEntry 3}
	nvmeDiskInfoFWVersion  OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The FWVersion associated with the NvmeDisk of this entry .
		"
		::= {nvmeDiskInfoEntry 4}
	nvmeDiskInfoModel  OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The Model associated with the NvmeDisk of this entry .
		"
		::= {nvmeDiskInfoEntry 5}
		  
	nvmeDiskInfoMfr  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The manufacture attach to associated with the Disk of this entry.
		"
		::= {nvmeDiskInfoEntry 6}
	 
	nvmeDiskInfoSerialNo  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The Disk serial number associated with the NvmeDisk of this entry.
		"
		::= {nvmeDiskInfoEntry 7}
		
	nvmeDiskInfoLinkSpeed  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The linkSpeed associated with the NvmeDisk of this entry.
		"
		::= {nvmeDiskInfoEntry 8}			
		
	nvmeDiskInfoCapacity  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The capacity associated with the NvmeDisk of this entry.
		"
		::= {nvmeDiskInfoEntry 9}
	nvmeDiskInfoTemp  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The temp associated with the NvmeDisk of this entry.
		"
		::= {nvmeDiskInfoEntry 10}
					

	nvmeDiskInfoPdlu  OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The pdlu associated with the NvmeDisk of this entry.
		"
		::= {nvmeDiskInfoEntry 11}
	nvmeDiskInfoStatus  OBJECT-TYPE
		SYNTAX 			Integer32
						{
						 present-nondetected(0),
						 present-detected(1)
						}
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The status associated with the NvmeDisk of this entry.
		"
		::= {nvmeDiskInfoEntry 12}
--nvmeDiskInfoTable end
