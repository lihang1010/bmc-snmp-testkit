--pamOrderTable start
--	pamOrderTable	OBJECT-TYPE
--	    SYNTAX     SEQUENCE OF pamOrderEntry
--	    MAX-ACCESS not-accessible
--	    STATUS     current
--	    DESCRIPTION
--	    "
--	    The table of pam order. If you want to change the PAM order, just set the corresponding service priority.
--	    "
--		::= {serverBmcInfo 19}
--	pamOrderEntry OBJECT-TYPE
--	    SYNTAX     pamOrderEntry
--	    MAX-ACCESS not-accessible
--	    STATUS     current
--	    DESCRIPTION
--	           ""
--	    INDEX   { 
--				  index                
--	            }
--	    ::= { pamOrderTable 1 }   
--	
--	pamOrderEntry ::= SEQUENCE {
--		index			Integer32,
--		pamOrderIPMI			Integer32,
--		pamOrderLDAP			Integer32,
--		pamOrderACTIVEDIRECTORY	Integer32,
--		pamOrderRADIUS			Integer32
--	}
--	index OBJECT-TYPE
--		SYNTAX 			Integer32
--		MAX-ACCESS		read-only
--		STATUS			current
--		DESCRIPTION 
--		"
--		The index associated with the pam order of this entry.	
--		"
--		::= {pamOrderEntry 1}
--	pamOrderIPMI OBJECT-TYPE
--		SYNTAX 			Integer32
--		MAX-ACCESS		read-write
--		STATUS			current
--		DESCRIPTION 
--		"
--		Enable critical events associated with the pam order of this entry. Set PAM order, you can choose 1-4.	
--		"
--		::= {pamOrderEntry 2}
--	pamOrderLDAP OBJECT-TYPE
--		SYNTAX 			Integer32
--		MAX-ACCESS		read-write
--		STATUS			current
--		DESCRIPTION 
--		"
--		Enable noncritical events associated with the pam order of this entry. Set PAM order, you can choose 1-4.	
--		"
--		::= {pamOrderEntry 3}
--	pamOrderACTIVEDIRECTORY OBJECT-TYPE
--		SYNTAX 			Integer32
--		MAX-ACCESS		read-write
--		STATUS			current
--		DESCRIPTION 
--		"
--		Enable nonrecoverable events associated with the pam order of this entry. Set PAM order ,you can choose 1-4.	
--		"
--		::= {pamOrderEntry 4}
--	pamOrderRADIUS OBJECT-TYPE
--		SYNTAX 			Integer32
--		MAX-ACCESS		read-only
--		STATUS			current
--		DESCRIPTION 
--		"
--		Enable fan state change events associated with the pam order of this entry. Set PAM order, you can choose 1-4.
--		"
--		::= {pamOrderEntry 5}
--pamOrderTable end
--logSettings start
	systemLogEnable  OBJECT-TYPE
		SYNTAX 			Integer32
						{
							disable(0),
							enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The enable associated with the system log function.
		"
		::= {advancedLog 1}
	localLogEnable  OBJECT-TYPE
		SYNTAX 			Integer32
						{
							disable(0),
							enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The enable associated with the local log function.
		"
		::= {advancedLog 2}
	remoteLogEnable  OBJECT-TYPE
		SYNTAX 			Integer32
						{
							disable(0),
							enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The enable associated with the remote log function.
		"
