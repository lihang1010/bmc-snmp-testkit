		The NTP server of the NTP conf.			
		"
		::= {bmcNTPConf 1} 

	bmcNTPServer2 OBJECT-TYPE
        SYNTAX          DisplayString
        MAX-ACCESS      read-write
        STATUS          current
        DESCRIPTION 
        "
        The NTP server of the NTP conf.         
        "
        ::= {bmcNTPConf 2} 
	bmcNTPDateTime  OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
