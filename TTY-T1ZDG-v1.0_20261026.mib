		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		""
		::= {healthStatus 2}
	fanHealthStatus OBJECT-TYPE
		SYNTAX 			Integer32  { normal(0), abnormal(1), absent(2) }
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		""
		::= {healthStatus 3} 
	cpuHealthStatus OBJECT-TYPE
		SYNTAX 			Integer32 { normal(0), abnormal(1), absent(2) }
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		""
		::= {healthStatus 4} 
	memoryHealthStatus OBJECT-TYPE
		SYNTAX 			Integer32 { normal(0), abnormal(1), absent(2) }
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		""
		::= {healthStatus 5} 
	diskHealthStatus OBJECT-TYPE
		SYNTAX 			Integer32 { normal(0), abnormal(1), absent(2) }
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		""
		::= {healthStatus 6}
	pcieHealthStatus OBJECT-TYPE
		SYNTAX 			Integer32 { normal(0), abnormal(1), absent(2) }
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		""
		::= {healthStatus 7} 
