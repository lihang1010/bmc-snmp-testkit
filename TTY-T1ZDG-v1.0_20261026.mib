--fanSensorTable start
	fanSensorTable OBJECT-TYPE
		SYNTAX SEQUENCE OF FanSensorEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""
		::= { serverAssetInfo 12 }
	fanSensorEntry OBJECT-TYPE
		SYNTAX FanSensorEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""
		INDEX { fanSensorIndex }
		::= { fanSensorTable 1 }
	FanSensorEntry ::=
		SEQUENCE {
			fanSensorIndex		Integer32,
			fanSensorName		DisplayString,
			fanSensorStatus		DisplayString,
			fanSensorValue		DisplayString,
			fanSensorLowNRT		DisplayString,
			fanSensorLowCT		DisplayString,
			fanSensorLowNCT		DisplayString,
			fanSensorUpNCT		DisplayString,
			fanSensorUpCT		DisplayString,
			fanSensorUpNRT		DisplayString
		}
	fanSensorIndex OBJECT-TYPE
		SYNTAX Integer32
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fanSensorEntry 1 }
	fanSensorName OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fanSensorEntry 2 }
	fanSensorStatus OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The sensor status associated with the fan sensor of this entry.
		"
		::= {fanSensorEntry 3} 
	fanSensorValue OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fanSensorEntry 4 }		
	fanSensorLowNRT OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The lower non-recoverable threshold associated with the fan sensor of this entry.
