		::= {bmcNTPConf 3} 
	bmcNTPAutoSync  OBJECT-TYPE
		SYNTAX 			Integer32{
						manual(0),
						auto(1)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The auto sync enable status of the NTP conf.	
