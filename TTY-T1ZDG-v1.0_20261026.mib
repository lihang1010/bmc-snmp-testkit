--discreteSensorTable start
	discreteSensorTable OBJECT-TYPE
		SYNTAX SEQUENCE OF DiscreteSensorEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""
		::= { serverAssetInfo 1 }
	discreteSensorEntry OBJECT-TYPE
		SYNTAX DiscreteSensorEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""
		INDEX { discreteSensorIndex }
		::= { discreteSensorTable 1 }
	DiscreteSensorEntry ::=
		SEQUENCE {
			discreteSensorIndex		Integer32,
			discreteSensorName		DisplayString,
			discreteSensorStatus	DisplayString,
			discreteSensorValue		DisplayString,
			discreteSensorLowNRT	DisplayString,
			discreteSensorLowCT		DisplayString,
			discreteSensorLowNCT	DisplayString,
			discreteSensorUpNCT		DisplayString,
			discreteSensorUpCT		DisplayString,
			discreteSensorUpNRT		DisplayString
		}
	discreteSensorIndex OBJECT-TYPE
		SYNTAX Integer32
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { discreteSensorEntry 1 }
	discreteSensorName OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { discreteSensorEntry 2 }
	discreteSensorStatus OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The sensor status associated with the temperature sensor of this entry.
		"
		::= {discreteSensorEntry 3} 
	discreteSensorValue OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { discreteSensorEntry 4 }		
	discreteSensorLowNRT OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The lower non-recoverable threshold associated with the temperature sensor of this entry.
		"
		::= {discreteSensorEntry 5}   
				  
	discreteSensorLowCT OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The lower critical threshold associated with the temperature sensor of this entry.
		"
		::= {discreteSensorEntry 6}
	      		  
	discreteSensorLowNCT OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The lower non-critical threshold associated with the temperature sensor of this entry.
		"
		::= {discreteSensorEntry 7}
			  
	discreteSensorUpNCT OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The upper non-critical threshold associated with the temperature sensor of this entry.
		"
		::= {discreteSensorEntry 8}
	      		  
	discreteSensorUpCT OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The upper critical threshold associated with the temperature sensor of this entry.
		"
		::= {discreteSensorEntry 9}
		  
	discreteSensorUpNRT OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The upper non-recoverable threshold associated with the temperature sensor of this entry.
		"
		::= {discreteSensorEntry 10}		
--discreteSensorTable end
--fruTable start
	fruTable OBJECT-TYPE
		SYNTAX SEQUENCE OF FruEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""
