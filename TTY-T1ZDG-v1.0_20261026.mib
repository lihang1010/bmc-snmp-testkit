--pcieInfoTable start
	pcieInfoTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF PcieInfoEntry
	    MAX-ACCESS read-only
	    STATUS     current
	    DESCRIPTION
	           "The table of PCIE information relevant to this entity's PCIE"
			::= {serverAssetInfo 5}
			
	pcieInfoEntry OBJECT-TYPE
	    SYNTAX     PcieInfoEntry
	    MAX-ACCESS read-only
	    STATUS     current
	    DESCRIPTION
	           "The PCIE information associated with the PCIE of this entry."
	    INDEX   { 
	    		  pcieInfoIndex
	            }
	    ::= { pcieInfoTable 1 }   
	
	PcieInfoEntry ::= SEQUENCE {
	    pcieInfoIndex					Integer32,
		pcieInfoNo						DisplayString,
		pcieInfoSlot		    		DisplayString,
		pcieInfoBusNo					DisplayString,
		pcieInfoDevNo					DisplayString,
		pcieInfoFuncNo					DisplayString,
--	    pcieInfoMac						DisplayString,
	    pcieInfoVendor					DisplayString,
	    pcieInfoDeviceType				DisplayString,
		pcieInfoDeviceDescription		DisplayString,
--		pcieInfoNetworkPortType			DisplayString,
--		pcieInfoNetworkPortSpeed		DisplayString,
	    pcieInfoRootBDF					DisplayString,
		pcieInfoRatedWidth				DisplayString,
		pcieInfoRatedSpeed				DisplayString,
		pcieInfoCurWidth				DisplayString,
		pcieInfoCurSpeed				DisplayString,
		pcieInfoCPUResource				DisplayString,
		pcieInfoHealth					Integer32,
		pcieInfoStatusDescription		DisplayString
	}  
	pcieInfoIndex  OBJECT-TYPE
		SYNTAX 			Integer32 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The index value which uniquely identifies 
			the interface to which this entry is applicable.
		"
		::= {pcieInfoEntry 1}    
	pcieInfoNo  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The device index associated with the PCIE of this entry
		"
		::= {pcieInfoEntry 2}
	pcieInfoSlot  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The Slot associated with the PCIE of this entry 
		"
		::= {pcieInfoEntry 3}
	pcieInfoBusNo  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The bus number associated with the PCIE of this entry
		"
		::= {pcieInfoEntry 4}
	pcieInfoDevNo  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The device number associated with the PCIE of this entry
		"
		::= {pcieInfoEntry 5}
	pcieInfoFuncNo  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The function number associated with the PCIE of this entry
		"
		::= {pcieInfoEntry 6}
--    pcieInfoMac  OBJECT-TYPE
