	bmcSMTPTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF BmcSMTPEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	    "
	    The table of service information.
	    "
		::= {serverBmcInfo 14}
	bmcSMTPEntry OBJECT-TYPE
	    SYNTAX     BmcSMTPEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	           ""
	    INDEX   { 
				  bmcSMTPIndex                
	            }
	    ::= { bmcSMTPTable 1 }   
	
	BmcSMTPEntry ::= SEQUENCE {
		bmcSMTPIndex				Integer32,
--		bmcSMTPLanInterface			DisplayString,
	    bmcSMTPEmailID				DisplayString,
	    bmcSMTPPrimarySupport		Integer32,
		bmcSMTPPrimaryServerName	DisplayString,
		bmcSMTPPrimaryServerIP		DisplayString,
		bmcSMTPPrimaryServerPort	Integer32,
		bmcSMTPPrimarySecurePort	Integer32,
		bmcSMTPPrimaryAuth			Integer32,
		bmcSMTPPrimaryUserName		DisplayString,
		bmcSMTPPrimaryPassword		DisplayString,
		bmcSMTPSecondSupport		Integer32,
		bmcSMTPSecondServerName		DisplayString,
		bmcSMTPSecondServerIP		DisplayString,
		bmcSMTPSecondServerPort		Integer32,
		bmcSMTPSecondSecurePort		Integer32,
		bmcSMTPSecondAuth			Integer32,
		bmcSMTPSecondUserName		DisplayString,
		bmcSMTPSecondPassword		DisplayString
	}
	bmcSMTPIndex OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
