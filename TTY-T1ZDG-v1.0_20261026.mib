	networkDedicatedIPv6StaticEntryIndex  OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"  
			The index value which uniquely identifies 
			the interface to which this entry is applicable.
		"
		::= {networkDedicatedIPv6StaticEntry 1}    
	networkDedicatedIPv6StaticIndex  OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The IPv6 index associated with the dedicated interface of this entry.
		"
		::= {networkDedicatedIPv6StaticEntry 2} 
	networkDedicatedIPv6StaticAddress  OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The IPv6 address associated with the dedicated interface of this entry.
		"
		::= {networkDedicatedIPv6StaticEntry 3} 
	networkDedicatedIPv6StaticPrefix  OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The IPv6 prefix associated with the dedicated interface of this entry.
		"
		::= {networkDedicatedIPv6StaticEntry 4}
--networkDedicatedIPv6StaticTable end
--bmcNTPConf start
	bmcNTPServer1 OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
