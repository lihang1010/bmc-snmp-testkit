--bmcUserManagement start
	bmcUserConfTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF BmcUserConfEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	    "
	    The table of dedicated user conf information relevant to this entity's dedicated user conf.
	    "
		::= {bmcUserManagement 1}
	bmcUserConfEntry OBJECT-TYPE
	    SYNTAX     BmcUserConfEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	           "The dedicated user conf information associated with the dedicated user conf of this entry."
	    INDEX   { 
				  bmcUserIndex                
	            }
	    ::= { bmcUserConfTable 1 }   
	
	BmcUserConfEntry ::= SEQUENCE {
		bmcUserIndex			Integer32,
	    bmcUserName				DisplayString,
		bmcUserPassword			DisplayString,
		bmcSNMPV3UserStatus		Integer32,
		bmcSNMPTYPE				Integer32,
		bmcSNMPV3UserAccess		Integer32,
	    bmcSNMPV3UserAuthProto	Integer32,
	    bmcSNMPV3UserPrivProto	Integer32,
		bmcUserGroupName		DisplayString,
		bmcEmailID				DisplayString
	}
	bmcUserIndex OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The index associated with the dedicated interface of this entry.	
		"
		::= {bmcUserConfEntry 1}		
	bmcUserName OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The name of the SNMPv3 user you want to set.	
		"
		::= {bmcUserConfEntry 2}	
	bmcUserPassword OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The password of the SNMPV3 user which is used to set authentication and privacy.	
		"
		::= {bmcUserConfEntry 3}
	bmcSNMPV3UserStatus OBJECT-TYPE
		SYNTAX 			Integer32
						{
						disable(0),
						enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The status of the SNMPV3 user.	
		"
		::= {bmcUserConfEntry 4}
	bmcSNMPTYPE OBJECT-TYPE
		SYNTAX 			Integer32{
						snmpv3(3)
		}
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		SNMP_TPYE, you can see the snmpv3.	
		3 for snmpv3.
		"
		::= {bmcUserConfEntry 5}
	bmcSNMPV3UserAccess OBJECT-TYPE
		SYNTAX 			Integer32{
						ro(1),
						rw(2)
		}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The access of the SNMPv3 user you want to set.	
		1 for read-only.
		2 for read-write.
		"
		::= {bmcUserConfEntry 6}
	bmcSNMPV3UserAuthProto OBJECT-TYPE
		SYNTAX 			Integer32{
						sha(1),
						md5(2),
						sha256(3),
						sha384(4),
						sha512(5)
		}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The authentication protocol of the SNMPv3 user , you can set 1 or 2 but not 0.	
		0 for without authentication protocol.
		1 for SHA.
		2 for MD5.
		3 for SHA256.
		4 for SHA384.
		5 for SHA512.
		"
		::= {bmcUserConfEntry 7}
	bmcSNMPV3UserPrivProto OBJECT-TYPE
		SYNTAX 			Integer32{
						des(1),
						aes(2)
		}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The privacy protocol of the SNMPv3 user.	
		0 for without privacy protocol.
		1 for DES.
		2 for AES.
		"
		::= {bmcUserConfEntry 8}
	bmcUserGroupName OBJECT-TYPE
		SYNTAX 			DisplayString									
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The user group name of the user.
		You can set different user group name and need to enter the group name you have chosen, as shown below:
		Administrator
		Operator
		User
		'OEMGroup1'
		'OEMGroup2'
		'OMEGroup3'
		'OEMGroup4'
		'OEMGroup5'
		please enter the group name.
		"
		::= {bmcUserConfEntry 9}
	bmcEmailID OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The email id of the user.	
		"
		::= {bmcUserConfEntry 10}
	addBmcUser OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		write-only
		STATUS			current
		DESCRIPTION 
		"
		Adding bmc user.
		The data format is 'username,password,userGroupName'.
		please enter the group name from the following actual group names.
		Administrator
		Operator
		User
		'OEMGroup1'
		'OEMGroup2'
		'OMEGroup3'
		'OEMGroup4'
		'OEMGroup5'
		"
		::= {bmcUserManagement 2} 
	delBmcUser OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		write-only
		STATUS			current
		DESCRIPTION 
		"
		Deleting bmc user by user name.
		"
		::= {bmcUserManagement 3} 
	userPasswdComplexity OBJECT-TYPE
		SYNTAX 			Integer32
						{
						disable(0),
						enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		user passwd complexity do check or not when user's passwd is being setting.
		"
		::= {bmcUserManagement 4} 
--bmcUserManagement end
--serviceTable start
	serviceTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF ServiceEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	    "
	    The table of service information.
	    "
		::= {serverBmcInfo 6}
	serviceEntry OBJECT-TYPE
	    SYNTAX     ServiceEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	           ""
	    INDEX   { 
				  serviceIndex                
	            }
	    ::= { serviceTable 1 }   
	
	ServiceEntry ::= SEQUENCE {
		serviceIndex			Integer32,
		serviceName				DisplayString,
	    serviceStatus			Integer32,
	    serviceInterface		DisplayString,
		serviceSecurePort		Integer32,
		serviceNonSecurePort	Integer32,
		serviceTimeOut			Integer32,
		serviceMaxSession		Integer32
	}
	serviceIndex OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The index associated with the service of this entry.	
		"
		::= {serviceEntry 1}
	serviceName OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The name of the service.	
		"
		::= {serviceEntry 2}
	serviceStatus OBJECT-TYPE
		SYNTAX 			Integer32
						{
						inactive(0),
						active(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The status associated with the service of this entry.	
		"
		::= {serviceEntry 3}
	serviceInterface OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The interface name associated with the service of this entry.	
		"
		::= {serviceEntry 4}
	serviceSecurePort OBJECT-TYPE
		SYNTAX 			Integer32
						{
							NA(-1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The secure port associated with the service of this entry.	
		"
		::= {serviceEntry 5}
	serviceNonSecurePort OBJECT-TYPE
		SYNTAX 			Integer32
						{
							NA(-1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The no secure port associated with the service of this entry.	
		"
		::= {serviceEntry 6}
	serviceTimeOut OBJECT-TYPE
		SYNTAX 			Integer32
						{
							NA(-1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The time out with the service of this entry.	
		"
		::= {serviceEntry 7}
	serviceMaxSession OBJECT-TYPE
		SYNTAX 			Integer32
						{
							NA(-1)
						}
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The max session count associated with the service of this entry.	
		"
		::= {serviceEntry 8}
--serviceTable end
--networkLinkTable start
--	networkLinkTable	OBJECT-TYPE
--	    SYNTAX     SEQUENCE OF networkLinkEntry
--	    MAX-ACCESS not-accessible
--	    STATUS     current
--	    DESCRIPTION
--	    "
--	    The table of service information.
--	    "
--		::= {serverBmcInfo 7}
--	networkLinkEntry OBJECT-TYPE
--	    SYNTAX     networkLinkEntry
--	    MAX-ACCESS not-accessible
--	    STATUS     current
--	    DESCRIPTION
--	           ""
--	    INDEX   { 
--				  networkLinkIndex                
--	            }
--	    ::= { networkLinkTable 1 }   
--	
--	networkLinkEntry ::= SEQUENCE {
--		networkLinkIndex		Integer32,
--		interfaceName			DisplayString,
--	    negotiationMode			Integer32,
--	    networkLinkSpeed		DisplayString,
--		networkLinkDuplexMode	Integer32
--	}
--	networkLinkIndex OBJECT-TYPE
--		SYNTAX 			Integer32
--		MAX-ACCESS		read-only
--		STATUS			current
--		DESCRIPTION 
--		"
--		The index associated with the network link of this entry.	
--		"
--		::= {networkLinkEntry 1}
--	interfaceName OBJECT-TYPE
--		SYNTAX 			DisplayString
--		MAX-ACCESS		read-only
--		STATUS			current
--		DESCRIPTION 
--		"
--		The interface name of the network.	
--		"
--		::= {networkLinkEntry 2}
--	negotiationMode OBJECT-TYPE
--		SYNTAX 			Integer32
--						{
--						manual(0),
--						auto(1)
--						}
--		MAX-ACCESS		read-write
--		STATUS			current
--		DESCRIPTION 
--		"
--		The negotiation mode associated with the network link of this entry.	
--		"
--		::= {networkLinkEntry 3}
--	networkLinkSpeed OBJECT-TYPE
--		SYNTAX 			DisplayString
--		MAX-ACCESS		read-write
--		STATUS			current
--		DESCRIPTION 
--		"
--		The speed associated with the network link of this entry.	
--		in auto mode, the speed is 1000 Mbps.
--		in manual mode, you can set the speed with 100 Mbps or 10 Mbps.
--		"
--		::= {networkLinkEntry 4}
--	networkLinkDuplexMode OBJECT-TYPE
--		SYNTAX 			Integer32
--						{
--							HalfDuplex(0),
--							FullDuplex(1)
--						}
--		MAX-ACCESS		read-write
--		STATUS			current
--		DESCRIPTION 
--		"
--		The duplex mode associated with the network link of this entry.	
--		"
--		::= {networkLinkEntry 5}
--networkLinkTable end
