--hddStatus start
	hddStatusTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF HddStatusEntry
	    MAX-ACCESS read-only
	    STATUS     current
	    DESCRIPTION
	    "
	    	The table of hddStatus information relevant to this entity's harddisk.
	    "
		::= {hddStatus 1}
	hddStatusEntry OBJECT-TYPE
	    SYNTAX     HddStatusEntry
	    MAX-ACCESS read-only
	    STATUS     current
	    DESCRIPTION
	    	"The Entry of hddStatus information relevant to this entity's harddisk."
	    INDEX   { 
				  hddStatusIndex		                
	            }
	    ::= { hddStatusTable 1 }   
	
	HddStatusEntry ::= SEQUENCE {
		hddStatusIndex		Integer32,
		hddLocation			DisplayString,
		hddHealth			Integer32,
		hddStatusDescription			DisplayString
	}
	hddStatusIndex  OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"  
			The index of the hdd.
		"
		::= {hddStatusEntry 1}           
	         

	hddLocation OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The name type of the hdd.
		"
		::= {hddStatusEntry 2}  
	hddHealth OBJECT-TYPE
		SYNTAX 			Integer32{ normal(0), abnormal(1), absent(2) }
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The disk health associated with the hddName.
		"
		::= {hddStatusEntry 3}
	hddStatusDescription  OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The disk status associated with the hddName.
		"
		::= {hddStatusEntry 4}
--hddStatus end
END
