			fruProductPartNum		OCTET STRING,
			fruProductVersion		OCTET STRING,
			fruProductSerialNum		OCTET STRING,
			fruProductAssetTag		OCTET STRING,
			fruProductExtra 		OCTET STRING,
			fruChassisType			OCTET STRING,
			fruChassisPartNum		OCTET STRING,
			fruChassisSerialNum		OCTET STRING,
			fruChassisExtra			OCTET STRING
		}
	fruIndex OBJECT-TYPE
		SYNTAX Integer32
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
