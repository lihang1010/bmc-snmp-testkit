--fanInfoTable start
	fanInfoTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF FanInfoEntry
	    MAX-ACCESS read-only
	    STATUS     current
	    DESCRIPTION
	           "The table of FAN information relevant to this entity's FAN"
			::= {serverAssetInfo 6}
			
	fanInfoEntry OBJECT-TYPE
	    SYNTAX     FanInfoEntry
	    MAX-ACCESS read-only
	    STATUS     current
	    DESCRIPTION
	           "The FAN information associated with the FAN of this entry."
	    INDEX   { 
	    		  fanInfoIndex
	            }
	    ::= { fanInfoTable 1 }   
	
	FanInfoEntry ::= SEQUENCE {
	    fanInfoIndex		Integer32,
	    fanInfoFanName		DisplayString,
		fanInfoSpeedIn		DisplayString,
		fanInfoSpeedOut		DisplayString,
		fanInfoDutyRatio	DisplayString,
		fanInfoHealth	Integer32
	}  
	fanInfoIndex  OBJECT-TYPE
		SYNTAX 			Integer32 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The index value which uniquely identifies 
			the interface to which this entry is applicable.
		"
		::= {fanInfoEntry 1}    
	fanInfoFanName  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The fan's name associated with the FAN of this entry
		"
		::= {fanInfoEntry 2}
	fanInfoSpeedIn  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The fan's inlet speed associated with the FAN of this entry
		"
		::= {fanInfoEntry 3}
	fanInfoSpeedOut  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The fan's outlet speed associated with the FAN of this entry
		"
		::= {fanInfoEntry 4}
	fanInfoDutyRatio  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The fan's duty ratio associated with the FAN of this entry, must >= 25%
		"
		::= {fanInfoEntry 5}
	fanInfoHealth  OBJECT-TYPE
		SYNTAX 			Integer32 { normal(0), abnormal(1), absent(2) }
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The fan's health status associated with the FAN of this entry
		"
		::= {fanInfoEntry 6}
--fanInfoTable end
