		nmPolicyMaxPower			Integer32,
		nmPolicyPowerCappingStatus	Integer32,
	    nmPolicyPowerLimitValue		Integer32,
		nmPolicyShutDown			Integer32,
		nmPolicyAlert				Integer32
	   }
