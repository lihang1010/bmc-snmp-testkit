--networkInterfaceTable start
	networkInterfaceTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF NetworkInterfaceEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	    "
	    The table of dedicated interface information relevant to this entity's dedicated interface.
	    "
		::= {serverBmcInfo 1}
	networkInterfaceEntry OBJECT-TYPE
	    SYNTAX     NetworkInterfaceEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	           "The dedicated interface information associated with the dedicated interface of this entry."
	    INDEX   { 
				  networkInterfaceIndex
	            }
	    ::= { networkInterfaceTable 1 }   
	
	NetworkInterfaceEntry ::= SEQUENCE {
		networkInterfaceIndex					Integer32,
	    networkInterfaceName					DisplayString,
	    networkInterfaceEnable					Integer32,
		networkInterfaceMACAddress				DisplayString,
		networkInterfaceIPv4Enable				Integer32,
	    networkInterfaceIPv4ObtainMethodConf	Integer32,
	    networkInterfaceIPv4Address				IpAddress,
	    networkInterfaceIPv4SubnetMask			IpAddress,
	    networkInterfaceIPv4Gateway				IpAddress,
		networkInterfaceIPv6Enable				Integer32,
	    networkInterfaceIPv6ObtainMethodConf	Integer32,
	    networkInterfaceIPv6Index				Integer32,
	    networkInterfaceIPv6Address				DisplayString,
	    networkInterfaceIPv6Prefix				Integer32,
	    networkInterfaceIPv6Gateway             DisplayString,
		networkInterfaceVlanEnable				Integer32,
		networkInterfaceVlanID					Integer32,
		networkInterfaceVlanPriority			Integer32
	}
	networkInterfaceIndex  OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"  
			The index value which uniquely identifies 
			the interface to which this entry is applicable.
		"
		::= {networkInterfaceEntry 1}           
	         
	networkInterfaceName OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The interface name associated with the dedicated interface of this entry.
		"
		::= {networkInterfaceEntry 2} 
	
	networkInterfaceEnable OBJECT-TYPE
		SYNTAX 			Integer32{
						disable(0),
						enable(1)
					} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The dedicated interface enable associated with the dedicated interface of this entry.
		"
		::= {networkInterfaceEntry 3}  
	
	networkInterfaceMACAddress OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The MAC address associated with the dedicated interface of this entry.
		"
		::= {networkInterfaceEntry 4} 

	networkInterfaceIPv4Enable OBJECT-TYPE
		SYNTAX 			Integer32{
						disable(0),
						enable(1)
					} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			Enable ipv4 network or not of this entry.
		"
		::= {networkInterfaceEntry 5} 

	networkInterfaceIPv4ObtainMethodConf  OBJECT-TYPE
		SYNTAX 			Integer32{
						static(1),
						dhcp(2)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The IPv4 Obtain Method associated with the dedicated interface of this entry.
			1 for static IP.
			2 for DHCP.
		"
		::= {networkInterfaceEntry 6} 
	
	networkInterfaceIPv4Address OBJECT-TYPE
		SYNTAX 			IpAddress 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The IPv4 address associated with the dedicated interface of this entry.
			If you want to set a static IP address and the gateway is invalid for the new IP address, 
			you need to first set the IPv4Gateway.
		"
		::= {networkInterfaceEntry 7}
	networkInterfaceIPv4SubnetMask OBJECT-TYPE
		SYNTAX 			IpAddress 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The IPv4 subnet mask associated with the dedicated interface of this entry.
		"
		::= {networkInterfaceEntry 8}    
	   
	networkInterfaceIPv4Gateway OBJECT-TYPE
		SYNTAX 			IpAddress 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The IPv4 Default gateway associated with the dedicated interface of this entry.
			If you want to set a static IP address and the gateway is invalid for the new IP address, 
			you need to first set the IPv4Gateway.
		"
		::= {networkInterfaceEntry 9}    
	networkInterfaceIPv6Enable OBJECT-TYPE
		SYNTAX 			Integer32{
						disable(0),
						enable(1)
					} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			Enable ipv6 network or not of this entry.
		"
		::= {networkInterfaceEntry 10} 

	networkInterfaceIPv6ObtainMethodConf  OBJECT-TYPE
		SYNTAX 			Integer32{
						static(1),
						dhcp(2)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The IPv6 Obtain Method associated with the dedicated interface of this entry.
			1 for static IP.
			2 for DHCP.
		"
		::= {networkInterfaceEntry 11} 	
	networkInterfaceIPv6Index OBJECT-TYPE
		SYNTAX 			Integer32 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The IPv6 index associated with the dedicated interface of this entry.
		"
		::= {networkInterfaceEntry 12} 

	networkInterfaceIPv6Address  OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The IPv6 address associated with the dedicated interface of this entry.
		"
		::= {networkInterfaceEntry 13} 
		
	networkInterfaceIPv6Prefix  OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The IPv6 prefix associated with the dedicated interface of this entry.
		"
		::= {networkInterfaceEntry 14}
	networkInterfaceIPv6Gateway OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The IPv6 Default gateway associated with the dedicated interface of this entry.
			If you want to set static ipaddress and the gateway is invalid for the new ipaddress,
			you should set the gateway to 0000.0000.0000.0000.0000.0000.0000.0000 or 0000::0000 and so on.
		"
		::= {networkInterfaceEntry 15} 
	networkInterfaceVlanEnable OBJECT-TYPE
		SYNTAX 			Integer32{
						disable(0),
						enable(1)
					} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The vlan enable status associated with the dedicated interface of this entry.
		"
		::= {networkInterfaceEntry 16}
	
	networkInterfaceVlanID OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The vlan ID associated with the dedicated interface of this entry.
			If you want to confiure the Vlan ID, make sure you had enable the Vlan.
		"
		::= {networkInterfaceEntry 17}
	
	networkInterfaceVlanPriority OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
			The vlan priority associated with the dedicated interface of this entry.
			If you want to confiure the Vlan priority, make sure you had enable the Vlan.
		"
		::= {networkInterfaceEntry 18}     
--networkInterfaceTable end
--networkSharedIPv6StaticTable start
