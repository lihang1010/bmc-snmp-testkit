--bmcDNSConf start
	bmcDNSEnable  OBJECT-TYPE
		SYNTAX 			Integer32{
						disable(0),
						enable(1)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The DNS enable of the BMC network interface DNS configuration.	
		"
		::= {bmcDNSConf 1}  
	bmcmDNSEnable  OBJECT-TYPE
		SYNTAX 			Integer32{
						disable(0),
						enable(1)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The multicast DNS enable of the BMC network interface DNS configuration.	
		"
		::= {bmcDNSConf 2}  
	bmcDNSHostMode  OBJECT-TYPE
		SYNTAX 			Integer32{
						manual(0),
						automatic(1)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The host setting of the BMC network interface DNS configuration.	
		"
		::= {bmcDNSConf 3}  
	bmcDNSHostName  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The host name of the BMC network interface DNS configuration.	
		"
		::= {bmcDNSConf 4} 
    
 	bmcDNSRegisterEth0Enable  OBJECT-TYPE
		SYNTAX 			Integer32{
						disable(0),
						enable(1)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The DNS eth0 enable of the BMC network interface DNS register.	
		"
		::= {bmcDNSConf 5}  
     bmcDNSRegisterEth0Method  OBJECT-TYPE
		SYNTAX 			Integer32{
						nsUpdate (0),
						dhcpClientFQDN (1),
						hostName(2),
						none(3)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The DNS eth0 configuration of the BMC network interface DNS register.	
		"
		::= {bmcDNSConf 6}
	bmcDNSRegisterEth1Enable  OBJECT-TYPE
		SYNTAX 			Integer32{
						disable(0),
						enable(1)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The DNS eth1 enable of the BMC network interface DNS register.	
		"
		::= {bmcDNSConf 7}  
     bmcDNSRegisterEth1Method  OBJECT-TYPE
		SYNTAX 			Integer32{
						nsUpdate (0),
						dhcpClientFQDN (1),
						hostName(2),
						none(3)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The DNS eth1 configuration of the BMC network interface DNS register.	
		"
		::= {bmcDNSConf 8}   
	bmcDNSDomainNetworkMode  OBJECT-TYPE
		SYNTAX 			Integer32{
						manual (0),
						automatic (1)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The DNS domain network mode of the BMC network interface DNS domain configuration.	
		"
		::= {bmcDNSConf 9}		
	bmcDNSDomainNetworkInterface  OBJECT-TYPE
		SYNTAX 			Integer32{
						eth0-v4 (0),  
						eth0-v6 (1), 
						eth1-v4 (2),  
						eth1-v6 (3)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The DNS domain network interface of the BMC network interface DNS domain configuration.	
		If eth1 is in static mode ,you cann't set 2.
		"
		::= {bmcDNSConf 10}      
	bmcDNSDomainName  OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The DNS domain name of the BMC network interface DNS domain configuration.	
		"
		::= {bmcDNSConf 11}
	bmcDNSDomainServerMode  OBJECT-TYPE
		SYNTAX 			Integer32{
						manual (0),
						automatic (1)
		} 
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The DNS domain server mode of the BMC network interface DNS server configuration.	
		"
		::= {bmcDNSConf 12}  
	bmcDNSDomainServerInterface  OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The DNS server interface of the BMC network interface DNS server configuration.	
		"
		::= {bmcDNSConf 13}  
