--sensorReadingInfoTable start
	sensorReadingInfoTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF SensorReadingInfoEntry
	    MAX-ACCESS read-only
	    STATUS     current
	    DESCRIPTION
	           "The table display Sensor Reading"
	 	::= {serverAssetInfo 28}
		
	sensorReadingInfoEntry OBJECT-TYPE
	    SYNTAX     SensorReadingInfoEntry
	    MAX-ACCESS read-only
	    STATUS     current
	    DESCRIPTION
	           "The table display Sensor Reading."
	    INDEX   { 
				  sensorReadingInfoIndex
	            }
	    ::= { sensorReadingInfoTable 1 }
		
	SensorReadingInfoEntry ::= 
	SEQUENCE {
	    sensorReadingInfoIndex     Integer32,
		sensorReading1       DisplayString,
		sensorReading2       DisplayString,
		sensorReading3       DisplayString,
		sensorReading4       DisplayString,
		sensorReading5       DisplayString,
		sensorReading6       DisplayString,
		sensorReading7       DisplayString,
