			The port associated with the remote server.
		"
		::= {advancedLog 19}
	logPolicyStatus  OBJECT-TYPE
		SYNTAX 			Integer32
						{
							linearStoragePolicy(0),
							circularStoragePolicy(1)
						}
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
			The log policy.
		"
		::= {logPolicy 1}
	logPolicyControl  OBJECT-TYPE
		SYNTAX 			Integer32
						{
							linearStoragePolicy(0),
							circularStoragePolicy(1)
						}
		MAX-ACCESS		write-only
		STATUS			current
		DESCRIPTION 
		"
			Setting the log policy.
		"
		::= {logPolicy 2}
--logSettings end
--serviceSession start
	serviceSessionTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF ServiceSessionEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	    "
	    The table of dedicated interface information relevant to this entity's dedicated interface.
	    "
		::= {serviceSession 1}
	serviceSessionEntry OBJECT-TYPE
	    SYNTAX     ServiceSessionEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	           "The dedicated interface information associated with the dedicated interface of this entry."
	    INDEX   { 
				  serviceSessionIndex		                
	            }
	    ::= { serviceSessionTable 1 }   
	
	ServiceSessionEntry ::= SEQUENCE {
		serviceSessionIndex		Integer32,
	    serviceSessionID		Integer32,
	    serviceSessionType		DisplayString,
		serviceSessionUserID	Integer32,
		serviceSessionUserName	DisplayString,
	    serviceSessionClientIP	DisplayString,
		serviceSessionPrivilege	DisplayString
	}
	serviceSessionIndex  OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"  
		The index of the session.
		"
		::= {serviceSessionEntry 1}           
	         
	serviceSessionID OBJECT-TYPE
		SYNTAX 			Integer32 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The session id of the session.
		"
		::= {serviceSessionEntry 2} 
	
	serviceSessionType OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The session type of the session.
		"
		::= {serviceSessionEntry 3}  
	
	serviceSessionUserID OBJECT-TYPE
		SYNTAX 			Integer32{
					NA(-1)
		}		
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The user id of the session.
		"
		::= {serviceSessionEntry 4} 

	serviceSessionUserName OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The user name of the session.
		"
		::= {serviceSessionEntry 5} 

	serviceSessionClientIP  OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The client ip of the session.
		"
		::= {serviceSessionEntry 6} 
	
	serviceSessionPrivilege OBJECT-TYPE
		SYNTAX 			DisplayString 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The privilege of the session.
		"
		::= {serviceSessionEntry 7}
	serviceSessionDelete OBJECT-TYPE
		SYNTAX 			Integer32 
		MAX-ACCESS		write-only
		STATUS			current
		DESCRIPTION 
		"
		Deleting session by session id.
		"
		::= {serviceSession 2}
--serviceSession end
--serverPowerControl start
	serverPowerStatus OBJECT-TYPE
		SYNTAX 			Integer32{
		    			powerOff(0),
			            powerOn(1)
		} 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		Get the server current  status of the power for read.			
		0 for server power off;
		1 for server power on;					
		"
		::= {serverPowerControl 1}  
	serverPowerStatusControl OBJECT-TYPE
		SYNTAX 			Integer32{
		    			powerOff(0),
			            powerOn(1),
						powerCycle(2),
						hardReset(3),
						ACPIClose(4)
		} 
		MAX-ACCESS		write-only
		STATUS			current
		DESCRIPTION 
		"
		Set the server current status of the power .	
		0 for set server power off;
		1 for set server power on;
		2 for set server power cycle;
		3 for set server hard reset;
		4 for set server ACPI close;	
		read always return 0xff;				
		"
		::= {serverPowerControl 2}  
--serverPowerControl end
--serverLocatedControl start
	serverIDLEDStatus OBJECT-TYPE
		SYNTAX 			Integer32{
		    			ledOff(0),
			            ledOn(1),
						ledBlink(2)
		} 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		Get the system ID LED  status.			
		0 for system ID LED  power off;
		1 for system ID LED  power on;	
				
		"
		::= {serverLocatedControl 1} 
	serverIDLEDStatusControl OBJECT-TYPE
		SYNTAX 			Integer32{
						ledOff(0),
						ledOn(1),
						ledBlink(2)
		}
		MAX-ACCESS		write-only
		STATUS			current
		DESCRIPTION 
		"
		Set the system ID LED  status.			
		0 for system ID LED  power off;
		other for system ID LED  power on time (seconds);	
		read always return 0xff;				
		"
		::= {serverLocatedControl 2}   
--serverLocatedControl end
--serverBootOptionControl start
	serverBootDev OBJECT-TYPE
		SYNTAX 			Integer32{
		    			bootdevNONE(0),
			            bootdevPXE(1),
						bootdevDISK(2),
						bootdevDIAG(3),
						bootdevCDROM(4),
						bootdevBIOS(5),
						bootdevFLOPPY(6),
						bootdevUSB(7)
		} 
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		Get the server current  boot option for read.			
		0 for do not change boot device order;
		1 for force PXE boot;
		2 for force boot from default Hard-drive;
		3 for force boot from Diagnostic Partition;
		4 for force boot from CD/DVD;
		5 for force boot into BIOS Setup;
		6 for force boot from Floppy removable media;
		7 for force boot from usb media;	
		"
		::= {serverBootOptionControl 1} 
	serverBootDevControl OBJECT-TYPE
		SYNTAX 			Integer32{
		    			bootdevNONE(0),
			            bootdevPXE(1),
						bootdevDISK(2),
						bootdevDIAG(3),
						bootdevCDROM(4),
						bootdevBIOS(5),
						bootdevFLOPPY(6),
						bootdevUSB(7)
		}
		MAX-ACCESS		write-only
		STATUS			current
		DESCRIPTION 
		"
		Set the server boot option of the chassis.			
		0 for do not change boot device order;
		1 for force PXE boot;
		2 for force boot from default Hard-drive;
		3 for force boot from Diagnostic Partition;
		4 for force boot from CD/DVD;
		5 for force boot into BIOS Setup;
		6 for force boot from Floppy removable media;
		7 for force boot from usb media;			
		"
		::= {serverBootOptionControl 2}   
--serverBootOptionControl end
--serverTemperatureInfo start
	inputtemperature1 OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { serverTemperatureInfo 1 }
	inputtemperature2 OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { serverTemperatureInfo 2 }          
--serverTemperatureInfo end 
