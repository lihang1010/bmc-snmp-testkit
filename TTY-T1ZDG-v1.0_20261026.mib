TTY-T4XDG-v1-4-MIB DEFINITIONS ::= BEGIN 
	IMPORTS
		enterprises, Integer32, OBJECT-TYPE 
            FROM SNMPv2-SMI
		DisplayString  
            FROM RFC1213-MIB 
    	IpAddress       
    		FROM RFC1155-SMI  
    	PhysAddress                        
    		FROM RFC1213-MIB; 
	
	ttyRoot 					OBJECT IDENTIFIER ::= {enterprises 52305}
	serverSysInfo				OBJECT IDENTIFIER ::= {ttyRoot 1}
	serverAssetInfo 			OBJECT IDENTIFIER ::= {ttyRoot 2}
	serverBmcInfo				OBJECT IDENTIFIER ::= {ttyRoot 3}  
	serverRemoteControl			OBJECT IDENTIFIER ::= {ttyRoot 4}
	serverSetUpOptionControl	OBJECT IDENTIFIER ::= {ttyRoot 5}
	serverTemperatureInfo		OBJECT IDENTIFIER ::= {ttyRoot 6}
	serverStatus				OBJECT IDENTIFIER ::= {ttyRoot 7}
	bmcNTPConf					OBJECT IDENTIFIER ::= {serverBmcInfo 4}
	bmcUserManagement			OBJECT IDENTIFIER ::= {serverBmcInfo 5}
	mediaRedirectionSettings	OBJECT IDENTIFIER ::= {serverBmcInfo 8}
	externalUserSettings		OBJECT IDENTIFIER ::= {serverBmcInfo 9}
	bmcDNSConf					OBJECT IDENTIFIER ::= {serverBmcInfo 10}
	--kvmMouseSetting				OBJECT IDENTIFIER ::= {serverBmcInfo 11}
	sslCertMessage				OBJECT IDENTIFIER ::= {serverBmcInfo 12}
	alarmSetting			OBJECT IDENTIFIER ::= {serverBmcInfo 13}
	--platformEventFilters		OBJECT IDENTIFIER ::= {serverBmcInfo 13}
	--firewallIPRulesConf		OBJECT IDENTIFIER ::= {serverBmcInfo 15}
	--firewallPortRulesConf		OBJECT IDENTIFIER ::= {serverBmcInfo 16}
	--firewallGeneralRulesConf	OBJECT IDENTIFIER ::= {serverBmcInfo 17}
	--videoSettings				OBJECT IDENTIFIER ::= {serverBmcInfo 18}
	logSettings					OBJECT IDENTIFIER ::= {serverBmcInfo 20}
	serviceSession				OBJECT IDENTIFIER ::= {serverBmcInfo 21}
	logPolicy					OBJECT IDENTIFIER ::= {logSettings 1}
	advancedLog					OBJECT IDENTIFIER ::= {logSettings 2}
	remoteSessionConf			OBJECT IDENTIFIER ::= {mediaRedirectionSettings 1}
	vmediaInstanceConf			OBJECT IDENTIFIER ::= {mediaRedirectionSettings 2}
	generalRADIUSConf			OBJECT IDENTIFIER ::= {externalUserSettings 1}
	sysFanConf					OBJECT IDENTIFIER ::= {serverAssetInfo 7}
	powerUnit					OBJECT IDENTIFIER ::= {serverAssetInfo 10}
	--powerConf					OBJECT IDENTIFIER ::= {powerUnit 2}
	--powerCommon					OBJECT IDENTIFIER ::= {powerUnit 3}
	serverPowerControl      	OBJECT IDENTIFIER ::= {serverRemoteControl 1}
	serverLocatedControl    	OBJECT IDENTIFIER ::= {serverRemoteControl 2}
	serverBootOptionControl    	OBJECT IDENTIFIER ::= {serverSetUpOptionControl 1}
	--eepromControl    			OBJECT IDENTIFIER ::= {serverSetUpOptionControl 2}
	healthStatus    			OBJECT IDENTIFIER ::= {serverStatus 1}
	hddStatus    				OBJECT IDENTIFIER ::= {serverStatus 2}
	
