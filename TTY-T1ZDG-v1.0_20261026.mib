	fruProductExtra OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 15 }
	fruChassisType OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 16 }
	fruChassisPartNum OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 17 }
	fruChassisSerialNum OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 18 }
	fruChassisExtra OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 19 }
