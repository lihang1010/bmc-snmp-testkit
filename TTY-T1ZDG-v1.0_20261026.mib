--snmptrapPoliciesTable start	
	snmptrapPoliciesTable	OBJECT-TYPE
	    SYNTAX     SEQUENCE OF SnmptrapPoliciesEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	    "
	    The table of snmp trap policy.
	    "
		::= {alarmSetting 1}
	snmptrapPoliciesEntry OBJECT-TYPE
	    SYNTAX     SnmptrapPoliciesEntry
	    MAX-ACCESS not-accessible
	    STATUS     current
	    DESCRIPTION
	           ""
	    INDEX   { 
				  snmptrapIndex                
	            }
	    ::= { snmptrapPoliciesTable 1 }   
	
	SnmptrapPoliciesEntry ::= SEQUENCE {
		snmptrapIndex			Integer32,
		snmptrapEnable			Integer32,
	    snmptrapVersion			Integer32,
	    snmptrapSeverity		Integer32,
		snmptrapPort			Integer32,
		snmptrapName			DisplayString,
		snmptrapCommunity		DisplayString,
		snmptrapEnginedId		DisplayString,
		snmptrapAlertEnable1		Integer32,
		snmptrapSnmpAddr1		DisplayString,
		snmptrapAlertEnable2		Integer32,
		snmptrapSnmpAddr2		DisplayString,
		snmptrapAlertEnable3		Integer32,
		snmptrapSnmpAddr3		DisplayString,
		snmptrapAlertEnable4		Integer32,
		snmptrapSnmpAddr4		DisplayString
		
	}
	snmptrapIndex OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The index associated with the snmptrap of this entry.	
		"
		::= {snmptrapPoliciesEntry 1}
	snmptrapEnable OBJECT-TYPE
		SYNTAX 			Integer32
						{
							diabled(0),
							enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap enable associated with the snmptrap of this entry.	
		"
		::= {snmptrapPoliciesEntry 2}
	snmptrapVersion OBJECT-TYPE
		SYNTAX 			Integer32
						{
							V1(1),
							V2(2),
							V3(3)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap version associated with the snmptrap of this entry.	
		"
		::= {snmptrapPoliciesEntry 3}
	snmptrapSeverity OBJECT-TYPE
		SYNTAX 			Integer32
						{
							info(1),
							waring(2),
							critical(3)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap severity associated with the snmptrap of this entry.	
		"
		::= {snmptrapPoliciesEntry 4}
	snmptrapPort OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap port associated with the snmptrap of this entry.	
		"
		::= {snmptrapPoliciesEntry 5}
	snmptrapName OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap name associated with the snmptrap of this entry.	
							
		"
		::= {snmptrapPoliciesEntry 6}
	snmptrapCommunity OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap community associated with the snmptrap of this entry.							
		"
		::= {snmptrapPoliciesEntry 7} 
	snmptrapEnginedId OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The engined id associated with the snmptrap of this entry.					
		"
		::= {snmptrapPoliciesEntry 8}
	snmptrapAlertEnable1 OBJECT-TYPE
		SYNTAX 			Integer32
						{
							diabled(0),
							enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap Alert 1 enable associated with the snmptrap of this entry.	
		"
		::= {snmptrapPoliciesEntry 9}
	snmptrapSnmpAddr1 OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap Alert 1 addr associated with the snmptrap of this entry.								
		"
		::= {snmptrapPoliciesEntry 10}
	snmptrapAlertEnable2 OBJECT-TYPE
		SYNTAX 			Integer32
						{
							diabled(0),
							enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap Alert 2 enable associated with the snmptrap of this entry.		
		"
		::= {snmptrapPoliciesEntry 11}
	snmptrapSnmpAddr2 OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap Alert 2 addr associated with the snmptrap of this entry.							
		"
		::= {snmptrapPoliciesEntry 12}
	snmptrapAlertEnable3 OBJECT-TYPE
		SYNTAX 			Integer32
						{
							diabled(0),
							enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap Alert 3 enable associated with the snmptrap of this entry.	
		"
		::= {snmptrapPoliciesEntry 13}
	snmptrapSnmpAddr3 OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap Alert 3 addr associated with the snmptrap of this entry.							
		"
		::= {snmptrapPoliciesEntry 14}
	snmptrapAlertEnable4 OBJECT-TYPE
		SYNTAX 			Integer32
						{
							diabled(0),
							enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap Alert 4 enable associated with the snmptrap of this entry.		
		"
		::= {snmptrapPoliciesEntry 15}
	snmptrapSnmpAddr4 OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The trap Alert 4 addr associated with the snmptrap of this entry.							
		"
		::= {snmptrapPoliciesEntry 16} 		
--snmptrapPoliciesTable end
