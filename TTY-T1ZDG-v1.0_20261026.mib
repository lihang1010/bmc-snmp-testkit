	fruBoardSerialNum OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 5 }
	fruBoardPartNum OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 6 }
	fruBoardMfrName OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 7 }
	fruBoardExtra OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 8 }
	fruProductMfrName OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 9 }
	fruProductName OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 10 }
	fruProductPartNum OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 11 }
	fruProductVersion OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 12 }
	fruProductSerialNum OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { fruEntry 13 }
	fruProductAssetTag OBJECT-TYPE
		SYNTAX OCTET STRING
