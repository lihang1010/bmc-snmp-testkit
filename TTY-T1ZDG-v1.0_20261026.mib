--cpuInfoTable start
	cpuInfoTable OBJECT-TYPE
		SYNTAX SEQUENCE OF CpuInfoEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""
		::= { serverAssetInfo 3 }
	cpuInfoEntry OBJECT-TYPE
		SYNTAX CpuInfoEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""
		INDEX { cpuIndex }
		::= { cpuInfoTable 1 }
	CpuInfoEntry ::=
		SEQUENCE {
			cpuIndex		Integer32,
			cpuType			OCTET STRING,
			cpuName			OCTET STRING,
			cpuCurrentSpeed		OCTET STRING,
			cpuCoreCount		Integer32,
			cpuL1Cache		OCTET STRING,
			cpuL2Cache		OCTET STRING,
			cpuL3Cache		OCTET STRING,
			cpuThreadNum		Integer32,
			cpuMaxSpeed		OCTET STRING,
			cpuInstruction		OCTET STRING,
			cpuManufacturer		OCTET STRING,
			cpuProcessorId		OCTET STRING,
			cpuSerialnum		OCTET STRING,
			cpuTemprature		OCTET STRING,
			cpuPresence			OCTET STRING,
			cpuHealth			Integer32
		}
	cpuIndex OBJECT-TYPE
		SYNTAX Integer32
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 1 }
	cpuType OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 2 }
	cpuName OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 3 }
	cpuCurrentSpeed OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 4 }
	cpuCoreCount OBJECT-TYPE
		SYNTAX Integer32{ NA(-1)}
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 5 }
	cpuL1Cache OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 6 }
	cpuL2Cache OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 7 }
	cpuL3Cache OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 8 }
	cpuThreadNum OBJECT-TYPE
		SYNTAX Integer32{ NA(-1)}
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 9 }
	cpuMaxSpeed OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 10 }
	cpuInstruction OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 11 }
	cpuManufacturer OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 12 }
	cpuProcessorId OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 13 }
	cpuSerialnum OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
		::= { cpuInfoEntry 14 }
	cpuTemprature OBJECT-TYPE
		SYNTAX OCTET STRING
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			""
