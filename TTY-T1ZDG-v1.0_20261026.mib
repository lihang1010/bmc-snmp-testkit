						enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		Enable smtp primary server.							
		"
		::= {bmcSMTPEntry 11} 
	bmcSMTPSecondServerName OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The name of the smtp second server.							
		"
		::= {bmcSMTPEntry 12} 
	bmcSMTPSecondServerIP OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The ip of the smtp second server.							
		"
		::= {bmcSMTPEntry 13} 
	bmcSMTPSecondServerPort OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The port of the smtp second server.							
		"
		::= {bmcSMTPEntry 14} 
	bmcSMTPSecondSecurePort OBJECT-TYPE
		SYNTAX 			Integer32
		MAX-ACCESS		read-only
		STATUS			current
		DESCRIPTION 
		"
		The secure port of the smtp second server.							
		"
		::= {bmcSMTPEntry 15} 
	bmcSMTPSecondAuth OBJECT-TYPE
		SYNTAX 			Integer32{
						diabled(0),
						enable(1)
						}
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		Enable smtp second server authentication.							
		"
		::= {bmcSMTPEntry 16} 
	bmcSMTPSecondUserName OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The user name of the smtp second server.							
		"
		::= {bmcSMTPEntry 17} 
	bmcSMTPSecondPassword OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS		read-write
		STATUS			current
		DESCRIPTION 
		"
		The password of the smtp second server.							
		"
		::= {bmcSMTPEntry 18} 
--bmcSMTPTable end
